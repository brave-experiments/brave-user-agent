# Template for direnv. Copy and fill in real values:
#
#   cp .envrc.example .envrc && direnv allow
#
# .envrc itself is gitignored — never commit real key material.

# Brave services HMAC signing key for the aichat backend.
# This is a signing key, not a bearer token: it is used to HMAC-SHA256 the
# request body digest and is never transmitted.
# Matched pair with BRAVE_SERVICES_KEY_ID below — the server derives its copy
# of this key from a master seed plus that id, so the two must correspond.
export SERVICES_KEY_AICHAT="replace-me"

# keyId sent in the Authorization header.
export BRAVE_SERVICES_KEY_ID="replace-me"

# Base URL of the aichat backend. The client appends the API path
# (v1/chat/completions), matching brave-core's GetEndpointUrl().
#
# Host is "<prefix>.<services-domain>" where the domains come from brave-core's
# brave_domains buildflags:
#   prod     ai-chat.bsg.brave.com
#   staging  ai-chat.bsg.bravesoftware.com
#   dev      ai-chat.bsg.brave.software     (VPN only; does not resolve otherwise)
#
# A services key is issued for one environment. Using it against another returns
# 401 with error 40101, "Invalid services key" — the signature is well-formed, the
# credential simply is not accepted there.
#
# The premium tier uses the ai-chat-premium.bsg prefix and additionally requires a
# SKU (subscription) credential; without one it returns 401 error 40104.
export BRAVE_AI_CHAT_ENDPOINT="https://ai-chat.bsg.brave.software"

# Point this at a locally running backend for development, e.g.
# export BRAVE_AI_CHAT_ENDPOINT="http://127.0.0.1:8000"

# Host for the premium tier, used once a Leo Premium subscription has been imported
# with `bua import-leo-creds`. Same environments, with the ai-chat-premium prefix:
#   prod     ai-chat-premium.bsg.brave.com
#   staging  ai-chat-premium.bsg.bravesoftware.com
#   dev      ai-chat-premium.bsg.brave.software     (VPN only)
#
# Optional. Without it premium is unavailable and every request goes to the endpoint
# above; a subscription credential is never sent to the free host, since it does not
# belong there.
#
# This must match the environment the subscription was created in, because a credential
# only verifies against its own environment's issuer. So pick the pair together:
#
#   dev/staging key  ->  ai-chat-premium.bsg.brave.software
#                        bua import-leo-creds development
#   production key   ->  ai-chat-premium.bsg.brave.com
#                        bua import-leo-creds stable
#
# Mismatching them returns 401: error 40101 for a key from the wrong environment, and
# 40104 for a credential from one.
export BRAVE_AI_CHAT_PREMIUM_ENDPOINT="https://ai-chat-premium.bsg.brave.software"

# Model to request from POST /v1/chat/completions.
# "automatic" lets the server triage per request and is the default.
#
# The model requested is not necessarily the model used: unrecognised names are
# silently reset to "automatic", some entries are weighted ensembles that resolve
# randomly, and "automatic" itself picks per request — observed selecting both
# claude-4-haiku and qwen-14b-instruct for identical prompts. Trust the model
# reported in the response, which `--trace` prints.
#
# Non-premium callers get a metered daily allowance of premium-tier automatic
# selections; once spent, requesting a premium model returns 403 error 40301. Free
# models such as llama-3-8b-instruct always work. GET /v1/models lists them with an
# "access" field.
export MODEL="automatic"
